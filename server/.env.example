# Server
HOST=127.0.0.1
PORT=8787
# Comma-separated origins. Localhost origins are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI is deterministic and local by default. Set to bedrock to opt in.
AI_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# If false, a Bedrock error falls back to the safe deterministic generator.
BEDROCK_STRICT=false
