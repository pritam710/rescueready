{
  "name": "rescueready",
  "version": "0.1.0",
  "private": true,
  "description": "Alexa+ household preparedness coach with a self-hosted MCP server",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace rescueready-server",
    "dev:web": "npm run dev --workspace rescueready-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
